# ============================================================================
# Portfolio Backend - environment variables
#
# Copy to .env (gitignored) or export these in your shell / hosting provider.
# Every value below has a local-development default in application.properties,
# so nothing here is required to boot locally - but nothing real belongs in git.
# ============================================================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5433/portfolio_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- Admin user (Spring Security basic) ---
ADMIN_USER=admin
ADMIN_PASS=

# --- JWT signing key: at least 64 random characters ---
# Generate one with:  openssl rand -base64 64
JWT_SECRET=

# --- Server ---
PORT=8080
